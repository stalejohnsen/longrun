# Supply-chain protection: never run install scripts from dependencies (ADR/CLAUDE.md)
ignore-scripts=true
# Pin exact versions; the lockfile is committed
save-exact=true
engine-strict=true
# Only install versions published at least 3 days ago (spec 0003, ADR 0008; npm >= 11.10).
# A security fix younger than that is installed with a one-command override (spec 0003 runbook).
min-release-age=3
