{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": ["Read(.env*)", "Read(*.pem)", "Read(*.key)"],
    "ask": [
      "Edit(/test/**)",
      "Edit(/vitest.config.*)",
      "Edit(/playwright.config.*)",
      "Edit(/eslint.config.*)",
      "Edit(/tsconfig*.json)",
      "Edit(/.github/**)",
      "Edit(/.npmrc)",
      "Edit(/package.json)",
      "Edit(/package-lock.json)",
      "Edit(/infra/bootstrap/**)",
      "Edit(/.claude/**)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm update *)",
      "Bash(npm uninstall *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types \"${CLAUDE_PROJECT_DIR}/scripts/claude-hooks/pre-tool-use.ts\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
